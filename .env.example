# ==========================================
# Trimly Web & Mobile API Environment Config
# ==========================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials to git!

# ------------------------------------------
# 1. MongoDB Database
# ------------------------------------------
# Connection string to MongoDB cluster (e.g., Atlas or local replica set)
MONGODB_URI="mongodb://localhost:27017/trimly"
MONGODB_DB="trimly"

# ------------------------------------------
# 2. Application URLs & NextAuth (Web)
# ------------------------------------------
# Web application public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt NextAuth session cookies (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"

# ------------------------------------------
# 3. Mobile Bearer Token & Data Encryption
# ------------------------------------------
# Secret used for signing mobile JWT access tokens (minimum 32 characters in production)
MOBILE_JWT_SECRET="replace-with-a-32-byte-random-secret-for-mobile-jwt"
MOBILE_JWT_EXPIRES_IN="15m"
MOBILE_REFRESH_TOKEN_EXPIRES_DAYS="30"

# 256-bit key in 64 hex characters for field-level AES-GCM encryption of tax IDs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY="replace-with-64-character-hex-string-for-aes-256-gcm-key"

# ------------------------------------------
# 4. Social Authentication (Google & Apple)
# ------------------------------------------
# Google OAuth (Web)
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-web-client-secret"

# Google OAuth (Mobile Native ID Token Verification)
GOOGLE_ANDROID_CLIENT_ID="your-google-android-client-id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your-google-ios-client-id.apps.googleusercontent.com"

# Sign in with Apple (Native ID Token Verification)
APPLE_BUNDLE_ID="app.trimly.ios"
APPLE_SERVICE_ID="app.trimly.web.auth"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_KEY_ID="YOUR_APPLE_KEY_ID"

# ------------------------------------------
# 5. Email Service (SMTP or Resend)
# ------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_SECURE="false"
EMAIL_FROM="Trimly <no-reply@trimly.app>"

# Optional Resend Fallback
RESEND_API_KEY=""

# ------------------------------------------
# 6. Object Storage (S3 / Cloudflare R2)
# ------------------------------------------
STORAGE_PROVIDER="memory" # Use "memory" for local dev/testing without AWS; "s3" or "r2" in production
S3_REGION="ap-south-1"
S3_ENDPOINT="" # Leave empty for AWS S3; specify for Cloudflare R2 (e.g., https://<account_id>.r2.cloudflarestorage.com)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BUCKET="trimly-public-media"
S3_PRIVATE_BUCKET="trimly-private-id-docs"
CDN_BASE_URL="https://cdn.trimly.app"

# ------------------------------------------
# 7. Push Notifications (FCM / APNs)
# ------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------
# 8. Proxy & Security Configuration
# ------------------------------------------
# Number of reverse proxies in front of Next.js (e.g., Cloudflare + ALB = 2; Vercel = 1)
TRUSTED_PROXY_HOPS="1"

# Mobile App Minimum Supported Version
MIN_SUPPORTED_APP_VERSION="1.0.0"
LATEST_APP_VERSION="1.0.0"


# ------------------------------------------
# 9. SMS Gateways (Phone OTP for Mobile Customers)
# ------------------------------------------
# Option A: Fast2SMS (Instant setup for India +91, free trial credits on signup at https://www.fast2sms.com)
FAST2SMS_API_KEY=""

# Option B: Twilio (Global carrier SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
